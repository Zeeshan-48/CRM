# Euron Open CRM API. Copy to .env for running the API outside Docker.
# Every provider below is optional: blank keys (or a *_SIMULATE=true flag) run
# that channel in simulated mode, so the whole app works with no accounts.
# Full reference: docs/guides/configuration.md

# ---- Server ----
NODE_ENV=development
PORT=5066
# Reverse proxies in front of the API (ALB = 1, CloudFront + ALB = 2).
TRUST_PROXY=1
# Browser origins allowed to call the API. Defaults to CRM_APP_URL,OPERATOR_APP_URL.
CORS_ORIGINS=

# ---- Secrets (production refuses to start on the defaults) ----
# Random, 32+ characters each. `make env` generates them for Docker.
JWT_SECRET=
JWT_EXPIRY=12h
# Encrypts every tenant-supplied credential at rest.
CREDENTIALS_ENCRYPTION_KEY=

# ---- PostgreSQL ----
# The API reads the PG_DATABASE_* variables. The migration runner (pnpm db:migrate)
# reads DATABASE_URL when it is set, else the same PG_DATABASE_* variables.
DATABASE_URL=postgres://crm:crm@localhost:5532/crm
PG_DATABASE_HOST=localhost
PG_DATABASE_PORT=5532
PG_DATABASE_USER=crm
PG_DATABASE_PASSWORD=crm
PG_DATABASE=crm
PG_POOL_MAX=10
PG_POOL_MIN=0

# ---- Redis (job scheduler, caches, rate limits). Blank = in-process fallback ----
REDIS_URL=redis://localhost:6469/0

# ---- Public URLs (bare origins, no trailing slash) ----
# The workspace app: sign-in, invite and reset links, booking pages, checkout returns.
CRM_APP_URL=http://localhost:3570
# The operator console: operator password-reset links.
OPERATOR_APP_URL=http://localhost:3580
# The API itself: unsubscribe links, OAuth callbacks, signed file links.
APP_PUBLIC_URL=http://localhost:5066
# Display name in emails and the default sender brand.
BRAND_NAME=Bn Orbit

# ---- AWS (S3 files, SES email, SQS events). Blank bucket = local disk ----
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Optional static keys; otherwise the default AWS credential chain (task role).
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
# Point every AWS client at an emulator (Floci) during local development.
AWS_ENDPOINT_URL=
# Platform sender. Blank = emails are simulated (recorded, not sent).
AWS_SES_REGION=
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_FROM_EMAIL=
AWS_SES_FROM_NAME=Bn Orbit
# Delivery events and inbound mail (created by the Terraform email module).
SES_EVENTS_SNS_TOPIC_ARN=
SES_EVENTS_QUEUE_URL=
SES_INBOUND_QUEUE_URL=
EMAIL_MAX_SEND_PER_SECOND=14

# ---- Google SMTP / Transactional Email (Primary delivery for Gmail / VPS) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=bnintelhub.services@gmail.com
SMTP_PASS=
SMTP_FROM_EMAIL=bnintelhub.services@gmail.com
SMTP_FROM_NAME=Bn Orbit

# ---- AI. Blank = the deterministic offline provider ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- WhatsApp Cloud API (platform default tier; tenants can connect their own) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_KEY=
WHATSAPP_SIMULATE=false
# Meta app for Embedded Signup and the shared webhook.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# ---- Telephony (Twilio platform default; Exotel is per tenant) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_FROM_NUMBER=
TELEPHONY_SIMULATE=false
EXOTEL_SIMULATE=false

# ---- Payments (tenant invoices: platform default tier; tenants can connect their own) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_SIMULATE=false
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=inr
STRIPE_SIMULATE=false

# ---- Platform billing (the operator charges tenants for their plan) ----
BILLING_SIMULATE=true
BILLING_GRACE_DAYS=3
BILLING_RETURN_URL=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# ---- Google Calendar (one OAuth app for the platform; each user connects their own) ----
# Enable the Google Calendar API, create a "Web application" OAuth client and
# register GOOGLE_OAUTH_REDIRECT_URL on it. Blank = meetings use a Jitsi link.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to {APP_PUBLIC_URL}/api/v1/oauth/google/calendar/callback.
GOOGLE_OAUTH_REDIRECT_URL=
GOOGLE_CALENDAR_ENABLED=true

# ---- Local file storage (used when AWS_S3_BUCKET is blank) ----
LOCAL_STORAGE_DIR=
