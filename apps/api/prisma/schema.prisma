generator kysely {
  provider     = "prisma-kysely"
  output       = "../src/db"
  enumFileName = "enums.ts"
  fileName     = "types.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model operator_users {
  id            String        @id
  email         String        @unique
  name          String
  password_hash String
  role          operator_role @default(OPERATOR)
  status        user_status   @default(ACTIVE)
  last_login_at DateTime?
  created_at    DateTime
  updated_at    DateTime

  @@index([status])
}

model plans {
  id            String   @id
  key           String   @unique
  name          String
  description   String?
  price_monthly Int      @default(0)
  currency      String   @default("INR")
  modules       Json
  limits        Json
  is_active     Boolean  @default(true)
  sort_order    Int      @default(0)
  created_at    DateTime
  updated_at    DateTime
}

model tenants {
  id                              String                       @id
  slug                            String                       @unique
  name                            String
  domain                          String?
  industry                        String?
  plan_key                        String?
  brand_color                     String                       @default("#b6207f")
  email_domain                    String?
  white_label                     Boolean                      @default(false)
  status                          tenant_status                @default(ACTIVE)
  config                          Json?
  created_at                      DateTime
  updated_at                      DateTime
  email_sending_status            email_sending_status         @default(ACTIVE)
  email_sending_status_changed_at DateTime?
  account_contracts               account_contracts[]
  accounts                        accounts[]
  activities                      activities[]
  agent_enrollments               agent_enrollments[]
  agent_outreach                  agent_outreach[]
  agent_runs                      agent_runs[]
  agent_settings                  agent_settings[]
  api_keys                        api_keys[]
  activity_events                 activity_events[]
  audit_logs                      audit_logs[]
  // Product integration platform (see the section at the end of this file).
  connected_apps                  connected_apps[]
  products                        products[]
  product_prices                  product_prices[]
  product_offers                  product_offers[]
  app_event_definitions           app_event_definitions[]
  app_identities                  app_identities[]
  engagement_profiles             engagement_profiles[]
  deal_line_items                 deal_line_items[]
  webhook_deliveries              webhook_deliveries[]
  automation_runs                 automation_runs[]
  booking_links                   booking_links[]
  calendar_connections            calendar_connections[]
  campaigns                       campaigns[]
  contacts                        contacts[]
  conversations                   conversations[]
  deals                           deals[]
  email_domain_health_checks      email_domain_health_checks[]
  email_messages                  email_messages[]
  email_reputation_events         email_reputation_events[]
  email_sender_identities         email_sender_identities[]
  email_sending_domains           email_sending_domains[]
  email_suppressions              email_suppressions[]
  email_templates                 email_templates[]
  files                           files[]
  integrations                    integrations[]
  invoices                        invoices[]
  lead_ingest_events              lead_ingest_events[]
  leads                           leads[]
  meetings                        meetings[]
  messages                        messages[]
  notifications                   notifications[]
  payments                        payments[]
  pipelines                       pipelines[]
  platform_transactions           platform_transactions[]
  reminders                       reminders[]
  roles                           roles[]
  saved_views                     saved_views[]
  sla_policies                    sla_policies[]
  stages                          stages[]
  tasks                           tasks[]
  tenant_razorpay                 tenant_razorpay[]
  tenant_stripe                   tenant_stripe[]
  tenant_subscriptions            tenant_subscriptions[]
  tenant_telephony                tenant_telephony[]
  telephony_numbers               telephony_numbers[]
  ticket_replies                  ticket_replies[]
  tickets                         tickets[]
  users                           users[]
  voice_calls                     voice_calls[]
  webhooks                        webhooks[]
  whatsapp_templates              whatsapp_templates[]
  workflows                       workflows[]
  kb_articles                     kb_articles[]
  lead_documents                  lead_documents[]
  tenant_entitlements             tenant_entitlements[]
  tenant_whatsapp                 tenant_whatsapp[]
}

model tenant_entitlements {
  id          String             @id
  tenant_id   String
  code        String
  enabled     Boolean            @default(true)
  limit_value Int?
  source      entitlement_source @default(PLAN)
  created_at  DateTime
  updated_at  DateTime
  tenants     tenants            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, code])
  @@index([tenant_id])
}

model operator_audit_logs {
  id                String   @id
  actor_operator_id String?
  actor_email       String?
  action            String
  category          String
  tenant_id         String?
  resource_id       String?
  summary           String
  metadata          Json?
  created_at        DateTime

  @@index([created_at])
  @@index([tenant_id])
  @@index([action])
}

model users {
  id                  String      @id
  tenant_id           String
  name                String
  email               String
  password_hash       String
  role                String
  status              user_status @default(ACTIVE)
  permissions         Json?
  territory           Json?
  skills              Json?
  avatar_color        String?
  last_login_at       DateTime?
  created_at          DateTime
  updated_at          DateTime
  phone               String?
  // Agent presence toggle: inbound call routing skips unavailable agents.
  available_for_calls Boolean     @default(true)
  tenants             tenants     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, email])
  @@index([tenant_id, role])
  @@index([tenant_id, status])
}

model roles {
  id          String   @id
  tenant_id   String
  key         String
  name        String
  permissions Json
  builtin     Boolean  @default(false)
  created_at  DateTime
  updated_at  DateTime
  tenants     tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, key])
}

model leads {
  id                   String           @id
  tenant_id            String
  name                 String
  email                String?
  phone                String?
  city                 String?
  country              String           @default("India")
  source               String?
  campaign             String?
  status               lead_status      @default(NEW)
  owner_id             String?
  tags                 Json?
  // Website + social profile links, keyed by network (website/linkedin/x/...).
  socials              Json?
  notes                String?
  budget               Boolean          @default(false)
  score_total          Int              @default(0)
  score_grade          lead_grade       @default(COLD)
  score_breakdown      Json?
  scored_at            DateTime?
  converted_contact_id String?
  converted_deal_id    String?
  external_id          String?
  external_source      String?
  // Free-form platform snapshot (rolled-up signals from external platforms, e.g.
  // plan_status, courses_published, checkout_abandoned). Not semantically owned
  // like tags/socials/score_breakdown, a generic bag maintained by ingest.
  custom_fields        Json?
  last_activity_at     DateTime?
  created_at           DateTime
  updated_at           DateTime
  lead_documents       lead_documents[]
  tenants              tenants          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, status])
  @@index([tenant_id, owner_id])
  @@index([tenant_id, source])
  @@index([tenant_id, score_grade])
  @@index([tenant_id, created_at])
}

model lead_documents {
  id          String   @id
  tenant_id   String
  lead_id     String
  name        String
  doc_type    String?
  file_key    String?
  url         String?
  uploaded_by String?
  created_at  DateTime
  leads       leads    @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  tenants     tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, lead_id])
}

model contacts {
  id                     String            @id
  tenant_id              String
  name                   String
  email                  String?
  phone                  String?
  company                String?
  account_id             String?
  title                  String?
  city                   String?
  owner_id               String?
  tags                   Json?
  socials                Json?
  lifecycle              contact_lifecycle @default(LEAD)
  converted_from_lead_id String?
  last_activity_at       DateTime?
  created_at             DateTime
  updated_at             DateTime
  tenants                tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, lifecycle])
  @@index([tenant_id, account_id])
  @@index([tenant_id, owner_id])
}

model accounts {
  id                String              @id
  tenant_id         String
  name              String
  industry          String?
  size              String?
  website           String?
  owner_id          String?
  departments       Json?
  created_at        DateTime
  updated_at        DateTime
  account_contracts account_contracts[]
  tenants           tenants             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model account_contracts {
  id         String          @id
  tenant_id  String
  account_id String
  // Set when the contract was auto-created from a won deal, also the
  // idempotency key so re-winning the same deal never duplicates a contract.
  deal_id    String?
  title      String
  value      Int             @default(0)
  status     contract_status @default(ACTIVE)
  start_at   DateTime?
  end_at     DateTime?
  created_at DateTime
  updated_at DateTime
  accounts   accounts        @relation(fields: [account_id], references: [id], onDelete: Cascade)
  tenants    tenants         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, account_id])
  @@index([tenant_id, deal_id])
}

model pipelines {
  id         String   @id
  tenant_id  String
  name       String
  is_default Boolean  @default(false)
  created_at DateTime
  updated_at DateTime
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  stages     stages[]

  @@index([tenant_id])
}

model stages {
  id          String    @id
  tenant_id   String
  pipeline_id String
  name        String
  sort_order  Int       @default(0)
  won         Boolean   @default(false)
  lost        Boolean   @default(false)
  created_at  DateTime
  updated_at  DateTime
  pipelines   pipelines @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  tenants     tenants   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, pipeline_id])
}

model deals {
  id                String      @id
  tenant_id         String
  pipeline_id       String
  stage_id          String
  title             String
  value             Int         @default(0)
  currency          String      @default("INR")
  owner_id          String?
  lead_id           String?
  account_id        String?
  contact_id        String?
  status            deal_status @default(OPEN)
  expected_close_at DateTime?
  closed_at         DateTime?
  competitors       Json?
  stakeholders      Json?
  lost_reason       String?
  win_probability   Int         @default(0)
  health_score      Int         @default(0)
  health_label      String?
  created_at        DateTime
  updated_at        DateTime
  tenants           tenants     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, pipeline_id, stage_id])
  @@index([tenant_id, status])
  @@index([tenant_id, owner_id])
}

model activities {
  id           String             @id
  tenant_id    String
  type         activity_type
  direction    message_direction?
  subject      String?
  notes        String?
  owner_id     String?
  lead_id      String?
  contact_id   String?
  deal_id      String?
  duration_sec Int?
  // True when an AI agent (autonomous voice call, sales agent, etc.) logged this
  // instead of a human. Lets the UI hide/badge bot activity so the team feed
  // isn't muddled with automated entries.
  ai_generated Boolean            @default(false)
  created_at   DateTime
  updated_at   DateTime
  tenants      tenants            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, created_at])
  @@index([tenant_id, lead_id])
  @@index([tenant_id, contact_id])
  @@index([tenant_id, deal_id])
}

model tasks {
  id                    String      @id
  tenant_id             String
  title                 String
  status                task_status @default(OPEN)
  priority              priority    @default(MEDIUM)
  due_at                DateTime?
  completed_at          DateTime?
  owner_id              String?
  lead_id               String?
  contact_id            String?
  deal_id               String?
  // When true, the task-reminders job emails the owner once a day (while OPEN)
  // until it is completed. reminder_last_sent_at is the idempotency stamp that
  // guarantees at most one reminder email per calendar day.
  remind_daily          Boolean     @default(false)
  reminder_last_sent_at DateTime?
  // True when an AI agent created this task (e.g. the sales agent's follow-ups),
  // so the UI can hide/badge it apart from human-created to-dos.
  ai_generated          Boolean     @default(false)
  created_at            DateTime
  updated_at            DateTime
  tenants               tenants     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, status])
  @@index([tenant_id, owner_id, status])
}

model conversations {
  id              String              @id
  tenant_id       String
  channel         channel
  lead_id         String?
  contact_id      String?
  subject         String?
  status          conversation_status @default(OPEN)
  unread_count    Int                 @default(0)
  last_message_at DateTime?
  last_preview    String?
  created_at      DateTime
  updated_at      DateTime
  tenants         tenants             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  messages        messages[]

  @@index([tenant_id, channel])
  @@index([tenant_id, last_message_at])
}

model messages {
  id              String            @id
  tenant_id       String
  conversation_id String
  channel         channel
  direction       message_direction
  body            String
  lead_id         String?
  contact_id      String?
  sender_user_id  String?
  sentiment       String?
  sentiment_score Int?
  simulated       Boolean           @default(true)
  // The provider's message id (WhatsApp wamid / email message id), used to
  // dedup inbound webhooks and to correlate delivery/read status back to the
  // outbound message. Delivery status: sent/delivered/read/failed.
  external_id     String?
  status          String?
  // The campaign this message was sent as part of (bulk send), so real delivery
  // status (from Meta's status webhook) can be aggregated per campaign.
  campaign_id     String?
  at              DateTime
  created_at      DateTime
  updated_at      DateTime
  conversations   conversations     @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  tenants         tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, conversation_id, at])
  @@index([tenant_id, lead_id])
  @@index([tenant_id, contact_id])
  @@index([tenant_id, external_id])
  @@index([tenant_id, campaign_id])
}

model whatsapp_templates {
  id         String               @id
  tenant_id  String
  key        String
  body       String
  category   wa_template_category @default(MARKETING)
  status     wa_template_status   @default(APPROVED)
  // Meta template metadata (populated by "Sync from Meta"): the exact language
  // code, the number of body {{n}} variables, and Meta's template id.
  language   String               @default("en_US")
  variables  Int                  @default(0)
  meta_id    String?
  created_at DateTime
  updated_at DateTime
  tenants    tenants              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, key])
}

model email_templates {
  id         String   @id
  tenant_id  String
  name       String
  subject    String
  body       String
  category   String?
  created_at DateTime
  updated_at DateTime
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model campaigns {
  id              String          @id
  tenant_id       String
  name            String
  channel         String
  cost            Int             @default(0)
  revenue         Int             @default(0)
  leads_generated Int             @default(0)
  status          campaign_status @default(ACTIVE)
  // Execution (bulk send), audience + content + send results. Null/0 for the
  // ROI-only campaigns that are never sent from the CRM.
  audience_tag    String?
  subject         String?
  body            String?
  // For WhatsApp campaigns: the ordered values for the template's {{1}}, {{2}}, …
  // body variables. Each entry may contain the literal token {name}, replaced
  // per-recipient with the lead's first name at send time. Null = legacy single
  // {name} param.
  template_params Json?
  recipients      Int             @default(0)
  sent            Int             @default(0)
  sent_at         DateTime?
  start_at        DateTime?
  end_at          DateTime?
  created_at      DateTime
  updated_at      DateTime
  tenants         tenants         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, status])
}

model tickets {
  id                String           @id
  tenant_id         String
  subject           String
  body              String?
  priority          ticket_priority  @default(MEDIUM)
  status            ticket_status    @default(OPEN)
  contact_id        String?
  assignee_id       String?
  channel           String?
  lead_id           String?
  sla_due_at        DateTime?
  first_response_at DateTime?
  resolved_at       DateTime?
  resolved_by       String?
  sentiment         String?
  escalated         Boolean          @default(false)
  csat              Int?
  created_at        DateTime
  updated_at        DateTime
  ticket_replies    ticket_replies[]
  tenants           tenants          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, status])
  @@index([tenant_id, assignee_id])
  @@index([tenant_id, lead_id])
  @@index([tenant_id, sla_due_at])
}

model ticket_replies {
  id             String   @id
  tenant_id      String
  ticket_id      String
  author_user_id String?
  is_ai          Boolean  @default(false)
  body           String
  channel        String?
  created_at     DateTime
  tenants        tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  tickets        tickets  @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, ticket_id])
}

model sla_policies {
  id                   String   @id
  tenant_id            String
  name                 String
  first_response_hours Int
  resolution_hours     Int
  is_default           Boolean  @default(false)
  created_at           DateTime
  updated_at           DateTime
  tenants              tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model kb_articles {
  id         String    @id
  tenant_id  String
  title      String
  body       String
  tags       Json?
  status     kb_status @default(PUBLISHED)
  views      Int       @default(0)
  created_at DateTime
  updated_at DateTime
  tenants    tenants   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, status])
}

model workflows {
  id          String    @id
  tenant_id   String
  name        String
  trigger     String
  actions     Json
  active      Boolean   @default(true)
  run_count   Int       @default(0)
  last_run_at DateTime?
  created_at  DateTime
  updated_at  DateTime
  tenants     tenants   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, trigger, active])
}

model automation_runs {
  id            String   @id
  tenant_id     String
  workflow_id   String?
  workflow_name String
  event         String
  log           Json
  created_at    DateTime
  tenants       tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, created_at])
}

model voice_calls {
  id                String            @id
  tenant_id         String
  lead_id           String?
  contact_id        String?
  agent_user_id     String?
  direction         message_direction @default(OUTBOUND)
  goal              String?
  provider          String            @default("simulated")
  duration_sec      Int               @default(0)
  transcript        Json?
  summary           String?
  sentiment_label   String?
  sentiment_score   Int?
  outcome           String?
  lead_score_delta  Int               @default(0)
  action_items      Json?
  completed_at      DateTime?
  created_at        DateTime
  updated_at        DateTime
  call_error        String?
  call_status       String?
  from_number       String?
  recording_url     String?
  to_number         String?
  twilio_call_sid   String?           @unique
  cost_cents        Int?
  external_call_id  String?           @unique
  structured_data   Json?
  engine_session_id String?
  agenda_id         String?
  // A pre-composed briefing block about the recipient (history, deal, notes…)
  // woven into the agent's system prompt. Used when a caller, e.g. the sales
  // agent, has richer context than the lead/contact row alone. `goal` above
  // carries the call's objective the same way.
  brief_context     String?
  tenants           tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, created_at])
  @@index([tenant_id, lead_id])
  @@index([tenant_id, agent_user_id])
}

model agent_runs {
  id           String   @id
  tenant_id    String
  agent        String
  triggered_by String?
  summary      String?
  actions      Json?
  created_at   DateTime
  tenants      tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, agent])
  @@index([tenant_id, created_at])
}

// A single agent-drafted outreach message. Doubles as the human-in-the-loop
// approval queue (status DRAFT until a user approves) AND the memory/suppression
// ledger the sales agent reads to avoid re-messaging the same lead. A DRAFT is
// never delivered; delivery happens only on approve, which flips it to SENT and
// links the resulting messages.id.
model agent_outreach {
  id          String    @id
  tenant_id   String
  agent       String
  run_id      String?
  lead_id     String?
  contact_id  String?
  channel     channel
  // DRAFT | APPROVED | SENT | REJECTED | FAILED | SKIPPED
  status      String    @default("DRAFT")
  subject     String?
  body        String
  // Short "why this lead / why now" shown to the reviewer (explainability).
  reason      String?
  // messages.id once the approved draft is delivered.
  message_id  String?
  created_by  String?
  reviewed_by String?
  approved_at DateTime?
  sent_at     DateTime?
  // Set when the lead replied after this outreach was sent, the outcome signal
  // behind reply-rate metrics and the targeting feedback loop.
  replied_at  DateTime?
  created_at  DateTime
  updated_at  DateTime
  tenants     tenants   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, agent, status])
  @@index([tenant_id, lead_id])
  @@index([tenant_id, agent, created_at])
}

// Per-tenant, per-agent automation config (Phase 2). One row per (tenant, agent).
// Defaults are deliberately safe: automation is OFF and auto_send is OFF, so
// nothing runs automatically until a tenant opts in from the UI.
model agent_settings {
  id               String   @id
  tenant_id        String
  agent            String
  enabled          Boolean  @default(false)
  score_threshold  Int      @default(65)
  // Preferred channel order, e.g. ["WHATSAPP","EMAIL"].
  channels         Json?
  // Freeform brand/tone hint fed to the composer.
  tone             String?
  // Sequence steps: [{ delayDays, angle }], the multi-touch cadence.
  cadence          Json?
  // { start, end, tz }, stored for forward-compat; not enforced yet.
  working_hours    Json?
  // Max drafts the automation may create per tenant per day (spam guard).
  daily_cap        Int      @default(20)
  // When true, approved-quality drafts are delivered immediately instead of
  // waiting in the review queue. Default false = human-in-the-loop.
  auto_send        Boolean  @default(false)
  // When true, a final AI voice call is appended to the sequence (falling back
  // to a human call task if the calling engine isn't configured/reachable).
  escalate_to_call Boolean  @default(false)
  created_at       DateTime
  updated_at       DateTime
  tenants          tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, agent])
}

// A lead progressing through an agent's multi-touch sequence (Phase 2). The
// scheduled runner picks up ACTIVE enrollments whose next_run_at has passed,
// drafts the next touch, and advances/completes. A reply flips it to REPLIED.
model agent_enrollments {
  id            String    @id
  tenant_id     String
