// Per-user OAuth link to an external calendar (Google today). Scoped to a user
// within a tenant; a meeting syncs to ITS OWNER's connection. Tokens are
// AES-256-GCM encrypted at rest (utils/crypto). Purely additive, absence of a
// row means CRM-native behavior (no external sync).
model calendar_connections {
  id                      String    @id
  tenant_id               String
  user_id                 String
  provider                String    @default("GOOGLE")
  // The connected account's email (shown in the UI; also the calendar id).
  account_email           String?
  access_token_encrypted  String?
  refresh_token_encrypted String?
  token_expires_at        DateTime?
  // OAuth scopes actually granted (space-joined), for diagnostics.
  scope                   String?
  // Whether push/pull sync is active for this connection (user can pause).
  sync_enabled            Boolean   @default(true)
  status                  String    @default("CONNECTED")
  last_error              String?
  created_at              DateTime
  updated_at              DateTime
  tenants                 tenants   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, user_id, provider])
  @@index([tenant_id, user_id])
}

