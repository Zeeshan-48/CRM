model tenant_telephony {
  id                   String           @id
  tenant_id            String
  provider             String           @default("TWILIO")
  // Twilio: account SID. Exotel: account SID (the URL path segment).
  account_sid          String?
  // Twilio: auth token. Exotel: API token. Same AES-GCM envelope either way.
  auth_token_encrypted String?
  // Exotel API key (basic-auth username). Twilio rows leave this null.
  api_key_encrypted    String?
  // Exotel API subdomain: api.in.exotel.com (India) or api.exotel.com (SG).
  subdomain            String?
  // Twilio: from-number. Exotel: the main marketing ExoPhone (default CallerId).
  from_number          String?
  // Unguessable per-tenant token carried in the public Exotel webhook URLs.
  // Exotel callbacks are unsigned, so this token IS the authentication.
  webhook_token        String?          @unique
  status               telephony_status @default(PENDING)
  verified_at          DateTime?
  last_error           String?
  created_at           DateTime
  updated_at           DateTime
  tenants              tenants          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

// ExoPhone pool: the tenant's main marketing number plus optional per-agent
// dedicated numbers. Powers outbound CallerId selection (agents dial out from
// "their" number, spreading volume and keeping one consistent number per
// relationship) and inbound ring-the-owner-first routing.
model telephony_numbers {
  id               String   @id
  tenant_id        String
  phone            String
  label            String?
  kind             String   @default("MAIN") // MAIN | AGENT
  assigned_user_id String?
  active           Boolean  @default(true)
  created_at       DateTime
  updated_at       DateTime
  tenants          tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, phone])
  @@index([tenant_id])
}

// Tenant BYO payment gateway (Razorpay). Mirrors tenant_telephony: the key
// secret is encrypted at rest; the key id is semi-public (used in checkout) so
// it's stored as-is. Status PENDING until validated against Razorpay.
model tenant_razorpay {
  id                   String           @id
  tenant_id            String
  provider             String           @default("RAZORPAY")
  key_id               String?
  key_secret_encrypted String?
  status               telephony_status @default(PENDING)
  verified_at          DateTime?
  last_error           String?
  created_at           DateTime
  updated_at           DateTime
  tenants              tenants          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

// Tenant BYO payment gateway (Stripe). Only a secret key is needed (encrypted
// at rest). Status PENDING until validated against Stripe.
model tenant_stripe {
  id                   String           @id
  tenant_id            String
  provider             String           @default("STRIPE")
  secret_key_encrypted String?
  status               telephony_status @default(PENDING)
  verified_at          DateTime?
  last_error           String?
  created_at           DateTime
  updated_at           DateTime
  tenants              tenants          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

// Tenant BYO WhatsApp (Meta Cloud API). Manual-credential model, mirroring
// tenant_telephony: the access token + app secret are encrypted at rest. Status
// PENDING until validated against Meta, then ACTIVE.
model tenant_whatsapp {
  id                         String           @id
  tenant_id                  String
  provider                   String           @default("META")
  phone_number_id            String?
  waba_id                    String?
  access_token_encrypted     String?
  app_secret_encrypted       String?
  webhook_verify_token       String?
  display_phone_number       String?
  verified_name              String?
  // Meta business (portfolio) id captured by Embedded Signup.
  business_id                String?
  // Cloud API 2FA registration PIN (encrypted). Reused verbatim on reconnect, // Meta locks the number for 7 days if a different PIN is submitted.
  registration_pin_encrypted String?
  // How this account was connected: EMBEDDED (Meta Embedded Signup) is the only
  // supported path going forward. MANUAL rows may exist from legacy connects.
  connect_method             String           @default("EMBEDDED")
  status                     telephony_status @default(PENDING)
  verified_at                DateTime?
  last_error                 String?
  created_at                 DateTime
  updated_at                 DateTime
  tenants                    tenants          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([waba_id])
}

