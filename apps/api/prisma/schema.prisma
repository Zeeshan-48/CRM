// Log of inbound lead-capture attempts (external platforms POSTing to the
// public ingest endpoint). Doubles as the idempotency store: a non-null
// external_id is unique per tenant, so provider redeliveries become no-ops.
model lead_ingest_events {
  id          String             @id
  tenant_id   String
  api_key_id  String?
  source      String
  external_id String?
  status      lead_ingest_status
  lead_id     String?
  error       String?
  payload     Json?
  created_at  DateTime
  tenants     tenants            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, external_id])
  @@index([tenant_id, created_at])
}

// Log of inbound platform-activity events (external platforms POSTing to the
// public /ingest/events endpoint). Kept SEPARATE from `activities` (the human
// sales timeline) so product telemetry never pollutes it or the O(n) scoring
// scan. `idempotency_key` is unique per tenant, so producer + payment-webhook
// redeliveries are no-ops. Stores the producer's `occurred_at` (which
// `activities` has no column for). `event` is a validated free string (not a DB
// enum) so new event names need no migration. `status`: RECORDED | ORPHAN |
// REJECTED (dedup short-circuits before insert, so no DEDUPED row).
model activity_events {
  id              String   @id
  tenant_id       String
  api_key_id      String?
  lead_id         String?
  event           String
  title           String?
  status          String
  occurred_at     DateTime
  idempotency_key String?
  payload         Json?
  error           String?
  created_at      DateTime
  // ---- Product-integration columns (all nullable, purely additive) ----
  // Which connected app produced this event. NULL only for rows written before
  // the product-integration platform existed.
  app_id          String?
  // The catalog item the event is about, resolved from payload.product.
  product_id      String?
  // Events follow the person, not the record: a lead that converts keeps its
  // stream via contact_id so product history survives conversion.
  contact_id      String?
  // The tracker's anonymous visitor id. Stored as a real column (not dug out of
  // `payload`) precisely because it is a LOOKUP key: when a visitor finally
  // identifies themselves, every earlier anonymous event is back-filled onto
  // them via this column, and a JSON scan would not survive real volume.
  anonymous_id    String?
  session_id      String?
  page_url        String?
  referrer        String?
  // Revenue-carrying events (checkout, subscription) in minor units.
  value_minor     Int?
  currency        String?
  tenants         tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, idempotency_key])
  @@index([tenant_id, lead_id, occurred_at])
  @@index([tenant_id, contact_id, occurred_at])
  @@index([tenant_id, app_id, occurred_at])
  // Drives the anonymous-to-known back-fill.
  @@index([tenant_id, app_id, anonymous_id])
  @@index([tenant_id, created_at])
}

