// ---------------------------------------------------------------------------
// Platform billing (operator tier): the operator charging tenants for their plan.
// Distinct from the tenant-scoped finance module (invoices/payments/tenant_*),
// which is a tenant billing their own customers. See docs/platform-billing.md.
// ---------------------------------------------------------------------------

// One live subscription per tenant (history retained on plan change/cancel).
// Payment is upfront: a tenant starts PENDING + tenants.status SUSPENDED until
// the first successful charge flips it ACTIVE.
model tenant_subscriptions {
  id                      String                  @id
  tenant_id               String
  plan_key                String
  gateway                 String
  billing_interval        billing_interval        @default(MONTHLY)
  // AUTO = gateway subscription auto-charges each cycle (mandate/saved card).
  // MANUAL = no mandate; the tenant pays a one-time link each cycle to renew.
  billing_mode            billing_mode            @default(AUTO)
  status                  subscription_status     @default(PENDING)
  gateway_customer_id     String?
  gateway_subscription_id String?                 @unique
  // Latest hosted pay/checkout URL while PENDING or awaiting a manual renewal;
  // cleared once a payment activates the subscription.
  checkout_url            String?
  // Gateway id of that pending link/session (Razorpay payment_link id / Stripe
  // checkout session id) so the poller can confirm payment without a webhook.
  checkout_ref            String?
  current_period_start    DateTime?
  current_period_end      DateTime?
  cancel_at_period_end    Boolean                 @default(false)
  canceled_at             DateTime?
  grace_until             DateTime?
  amount                  Int
  currency                String                  @default("INR")
  created_at              DateTime
  updated_at              DateTime
  platform_transactions   platform_transactions[]
  tenants                 tenants                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([status])
  @@index([current_period_end])
}

// Operator<->tenant ledger: one row per charge / attempt / refund.
model platform_transactions {
  id                   String               @id
  tenant_id            String
  subscription_id      String
  gateway              String
  gateway_invoice_id   String?              @unique
  gateway_payment_id   String?
  amount               Int
  currency             String               @default("INR")
  status               platform_txn_status  @default(PENDING)
  kind                 platform_txn_kind    @default(CYCLE)
  period_start         DateTime?
  period_end           DateTime?
  hosted_invoice_url   String?
  failure_reason       String?
  occurred_at          DateTime
  created_at           DateTime
  updated_at           DateTime
  tenant_subscriptions tenant_subscriptions @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  tenants              tenants              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([subscription_id])
  @@index([status])
}

// Maps an internal plan + interval to the external gateway plan/price id.
// plan_key is a soft reference to plans.key (mirrors tenants.plan_key).
model plan_gateway_refs {
  id               String           @id
  plan_key         String
  gateway          String
  billing_interval billing_interval @default(MONTHLY)
  external_plan_id String
  amount           Int
  currency         String           @default("INR")
  active           Boolean          @default(true)
  created_at       DateTime
  updated_at       DateTime

  @@unique([plan_key, gateway, billing_interval])
}

// Idempotency + audit for inbound gateway webhooks (Razorpay/Stripe retry).
model platform_webhook_events {
  id           String   @id
  gateway      String
  event_id     String   @unique
  event_type   String
  status       String   @default("PROCESSED")
  error        String?
  processed_at DateTime
  created_at   DateTime

  @@index([gateway, event_type])
}

enum subscription_status {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  PAUSED
  GRANDFATHERED
}

enum billing_interval {
  MONTHLY
  ANNUAL
}

enum billing_mode {
  AUTO
  MANUAL
}

enum platform_txn_status {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum platform_txn_kind {
  CYCLE
  SETUP
  PRORATION
  REFUND
}

// =============================================================================
// PRODUCT INTEGRATION PLATFORM
// Lets ANY external software product integrate with the CRM: publish its
// catalog, stream what a person does inside it, and receive CRM events back.
// See docs/product-integration-plan.md. Every table is additive: a workspace
// with no connected app behaves exactly as it did before these existed.
// =============================================================================

// The external system itself (Salesforce calls this a Connected App). One row
// per product a workspace has wired up. API keys, catalog rows, event
// definitions and engagement profiles all hang off this.
model connected_apps {
  id          String  @id
  tenant_id   String
  key         String // slug, e.g. "acme-cloud"
  name        String
  description String?
  logo_url    String?
  // Base URL used to build deep links back into the product from CRM records.
  product_url String?
  status      String  @default("ACTIVE") // ACTIVE | PAUSED | DISABLED
  environment String  @default("LIVE") // LIVE | TEST (TEST never affects scoring)

  // { catalog, events, identity, deeplink, outbound, actions } booleans.
  capabilities Json?

  // ---- Catalog sync ----
  catalog_mode         String    @default("PUSH") // PUSH | PULL | MANUAL
  catalog_pull_url     String?
  last_catalog_sync_at DateTime?

  // ---- CRM -> product (actions the agent can fire from a record) ----
  actions_url     String?
  // AES-256-GCM at rest via utils/crypto, same as calendar_connections tokens.
  actions_secret  String?
  // [{ key, label, description, params_schema, confirm }] declared by the product.
  actions_catalog Json?

  // ---- Browser tracker ----
  // string[] origin allowlist enforced for PUBLISHABLE-scoped keys.
  allowed_origins Json?

  // ---- Health (surfaced on the integration console) ----
  last_event_at DateTime?
  health        String    @default("PENDING") // PENDING | OK | STALE | ERROR
  last_error    String?

  created_at DateTime
  updated_at DateTime
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, key])
  @@index([tenant_id, status])
}

// The sellable catalog (Salesforce Product2). `source` decides authority:
// SYNCED rows are owned by the external product and read-only in the CRM;
// MANUAL rows are created by an admin for things the product does not expose.
model products {
  id          String  @id
  tenant_id   String
  app_id      String? // NULL = CRM-native product
  external_id String? // the product's own id, the upsert key
  sku         String?
  name        String
  description String? // markdown, rendered in the agent panel
  category    String?
  family      String?
  url         String? // deep link to the live product page
  media       Json? // { thumbnail, images[] }
  attributes  Json? // free-form, product-defined (level, duration, seats, ...)
  highlights  Json? // string[], the pitch bullets an agent reads out
  status      String  @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  source      String  @default("SYNCED") // SYNCED | MANUAL
  sort_order  Int     @default(0)
  total_sales Int     @default(0)

  synced_at  DateTime?
  created_at DateTime
  updated_at DateTime
  tenants    tenants   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, app_id, external_id])
  @@index([tenant_id, status])
  @@index([tenant_id, category])
  @@index([tenant_id, app_id])
}

// A price book entry (Salesforce PricebookEntry), flattened. Amounts are MINOR
// units (paise/cents) because integrating products speak minor units. The
// deal-line-item bridge converts once, explicitly. See the plan doc.
model product_prices {
  id               String  @id
  tenant_id        String
  product_id       String
  price_book       String  @default("STANDARD")
  currency         String  @default("INR")
  amount_minor     Int
  compare_at_minor Int? // strike-through / list price
  billing_period   String  @default("ONE_TIME") // ONE_TIME | MONTHLY | QUARTERLY | YEARLY
  is_default       Boolean @default(false)

  created_at DateTime
  updated_at DateTime
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, product_id, price_book, currency, billing_period])
  @@index([tenant_id, product_id])
}

// Offers and coupons unified behind a nullable `code`: an offer WITH a code is
// a coupon. One table, one panel, one mental model for the agent.
model product_offers {
  id          String  @id
  tenant_id   String
  app_id      String?
  product_id  String? // NULL = applies across products (see applies_to)
  code        String? // NULL = a plain offer, non-null = a coupon
  name        String
  description String?
  terms       String?

  discount_type  String // PERCENT | FLAT
  discount_value Int // percent 0-100, or minor units when FLAT
  currency       String?
  applies_to     Json? // { product_ids: [], categories: [] }

  starts_at        DateTime?
  ends_at          DateTime?
  max_redemptions  Int?
  redemptions_used Int       @default(0)
  status           String    @default("ACTIVE") // ACTIVE | SCHEDULED | EXPIRED | DISABLED

  created_at DateTime
  updated_at DateTime
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, app_id, code])
  @@index([tenant_id, product_id, status])
  @@index([tenant_id, status, ends_at])
}

// Per-app event registry (HubSpot's event definitions). An event name the CRM
// has never seen is ACCEPTED and auto-registered here as NEEDS_REVIEW rather
// than rejected, so a producer is never blocked. NEEDS_REVIEW definitions do
// not contribute to intent scoring until an admin activates them.
model app_event_definitions {
  id          String  @id
  tenant_id   String
  app_id      String
  name        String // "checkout.started"
  label       String // "Started checkout"
  description String?
  category    String  @default("ACTION") // PAGE | ACTION | LIFECYCLE | COMMERCE | SUPPORT
  icon        String?

  // Scoring inputs. intent_weight is -100..100 and is summed with recency decay.
  intent_weight  Int     @default(0)
  is_high_intent Boolean @default(false)

  // { key: { type, label, show_in_timeline } }, drives generic rendering.
  property_schema Json?

  review_status   String    @default("ACTIVE") // ACTIVE | NEEDS_REVIEW | IGNORED
  auto_registered Boolean   @default(false)
  event_count     Int       @default(0)
  last_seen_at    DateTime?

  created_at DateTime
  updated_at DateTime
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, app_id, name])
  @@index([tenant_id, review_status])
  @@index([tenant_id, app_id])
}

// The identity graph. Without this there is no way to attach pre-signup
// browsing to the person who later hands over an email, which is the whole
// point of "previous history of engagement".
model app_identities {
  id             String  @id
  tenant_id      String
  app_id         String
  identity_type  String // EXTERNAL_USER_ID | EMAIL | PHONE | ANONYMOUS_ID
  identity_value String
  lead_id        String?
  contact_id     String?

  first_seen_at DateTime
  last_seen_at  DateTime
  created_at    DateTime
  tenants       tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, app_id, identity_type, identity_value])
  @@index([tenant_id, lead_id])
  @@index([tenant_id, contact_id])
}

// One rollup row per (person, app). Replaces the LMS-shaped JSON bag that used
// to live on leads.custom_fields. Product-specific counters live in `usage`,
// NAMED BY THE PRODUCT and rendered generically from app_event_definitions, // that is how a new product is supported with zero CRM code change.
model engagement_profiles {
  id         String  @id
  tenant_id  String
  app_id     String
  lead_id    String?
  contact_id String?

  lifecycle_stage String  @default("VISITOR") // VISITOR|SIGNED_UP|TRIAL|ACTIVE|PAYING|CHURNED
  plan_name       String?
  plan_status     String?
  mrr_minor       Int?
  currency        String?

  first_seen_at DateTime?
  last_seen_at  DateTime?
  signup_at     DateTime?
  trial_ends_at DateTime?

  // Rolling 30-day windows, refreshed by the engagement-rollup sweep.
  sessions_30d    Int @default(0)
  events_30d      Int @default(0)
  page_views_30d  Int @default(0)
  active_days_30d Int @default(0)

  intent_score   Int    @default(0) // 0-100
  intent_band    String @default("COLD") // HOT | WARM | COLD
  // [{ label, weight }], the plain-English "why", so an agent can interrogate
  // the number instead of ignoring it.
  intent_reasons Json?

  checkout_abandoned_at DateTime?
  abandoned_cart        Json? // { product_ids: [], value_minor, currency }
  top_products          Json? // [{ product_id, views, last_at }]
  usage                 Json? // product-defined counters

  created_at DateTime
  updated_at DateTime
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, app_id, lead_id])
  @@unique([tenant_id, app_id, contact_id])
  @@index([tenant_id, intent_band, last_seen_at])
  @@index([tenant_id, app_id])
}

// Salesforce OpportunityLineItem. deals.value becomes DERIVED when a deal has
// line items and falls back to the manually entered scalar when it does not,
// so no existing pipeline behaviour changes.
model deal_line_items {
  id         String  @id
  tenant_id  String
  deal_id    String
  product_id String? // NULL = ad-hoc line, not from the catalog
  offer_id   String?
  name       String
  quantity   Int     @default(1)

  unit_price_minor Int
  discount_minor   Int    @default(0)
  total_minor      Int
  currency         String @default("INR")
  sort_order       Int    @default(0)

  created_at DateTime
  updated_at DateTime
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, deal_id])
  @@index([tenant_id, product_id])
}

// Outbound delivery log. The `webhooks` subscription table already existed but
// nothing ever dispatched; this is the log that makes delivery observable,
// debuggable and replayable.
model webhook_deliveries {
  id            String  @id
  tenant_id     String
  webhook_id    String
  event         String
  payload       Json
  status        String  @default("PENDING") // PENDING | SUCCEEDED | FAILED | EXHAUSTED
  attempt       Int     @default(0)
  response_code Int?
  response_body String?
  error         String?

  next_retry_at DateTime?
  delivered_at  DateTime?
  created_at    DateTime
  tenants       tenants   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, webhook_id, created_at])
  @@index([status, next_retry_at])
}
