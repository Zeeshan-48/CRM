{
  "name": "bn-orbit",
  "version": "2.0.0",
  "private": true,
  "description": "Bn Orbit: Self-hosted multi-tenant CRM: leads, deals, inbox over email and WhatsApp, campaigns, tickets, workflows, telephony, AI copilot and product-signal ingestion, with an operator plane that sells plans and bills tenants. Express + Postgres + React, Terraform for AWS, a local AWS emulator for development.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @open-crm/api test:integration",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx db/migrate.ts",
    "demo:seed": "pnpm --filter @open-crm/api demo:seed",
    "sanitize": "scripts/check-sanitization.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.6",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "pg": "^8.16.3",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "turbo": "^2.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.1.12",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "bcrypt",
      "prisma",
      "@prisma/engines",
      "@prisma/client"
    ],
    "overrides": {
      "postcss@<8.5.23": "^8.5.29",
      "vite": "^7.1.12"
    }
  }
}
