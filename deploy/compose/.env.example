# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
CRM_JWT_SECRET=replace-with-output-of-make-env
# Encrypts every credential a tenant stores. Changing it makes the stored ones
# unreadable (re-enter them in the app).
CRM_CREDENTIALS_ENCRYPTION_KEY=replace-with-output-of-make-env
# Every demo account (make demo) signs in with this password (passed to the seed as
# DEMO_PASSWORD).
CRM_DEMO_PASSWORD=replace-with-output-of-make-env

# Every provider runs simulated locally (WHATSAPP_SIMULATE, TELEPHONY_SIMULATE,
# EXOTEL_SIMULATE, RAZORPAY_SIMULATE, STRIPE_SIMULATE and
# BILLING_SIMULATE default to true). To try a real test account, set its keys and turn
# its switch off, e.g.:
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TELEPHONY_SIMULATE=false
# Every key in this file reaches the API container (env_file). Tenants normally bring
# their own provider accounts in the app instead.

# AI: blank uses the deterministic offline engine.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Files: local disk by default. With the Floci overlay, the emulated bucket:
# AWS_S3_BUCKET=open-crm-local-files

# Optional overrides (host ports and names)
# CRM_BRAND_NAME=Open CRM
# LOG_LEVEL=info
# CRM_WEB_PORT=3570
# CRM_CONSOLE_PORT=3580
# CRM_API_PORT=5066
# CRM_PG_PORT=5532
# CRM_REDIS_PORT=6469
# CRM_FLOCI_PORT=4637
# CRM_MAILPIT_PORT=8086
