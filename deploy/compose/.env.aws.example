# Real AWS resources for `make up-aws`. Values come from `terraform output` in
# infra/terraform/envs/aws-dev (or resources you created yourself). No secrets here:
# the S3 client uses your AWS profile, mounted read-only into the API container, and
# the SES and SQS keys (AWS_SES_ACCESS_KEY, AWS_SES_SECRET_KEY) belong in the
# git-ignored deploy/compose/.env.
AWS_REGION=us-east-1
AWS_PROFILE=default
AWS_S3_BUCKET=<terraform output storage_bucket>
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=<terraform output mail_from>
SES_EVENTS_SNS_TOPIC_ARN=<terraform output ses_queues: SES_EVENTS_SNS_TOPIC_ARN>
SES_EVENTS_QUEUE_URL=<terraform output ses_queues: SES_EVENTS_QUEUE_URL>
# SES_INBOUND_QUEUE_URL=<terraform output ses_queues: SES_INBOUND_QUEUE_URL>
# SES_INBOUND_REGION=us-east-1
# Values here win over the compose defaults (make up-aws reads this file as an
# --env-file). Providers stay simulated unless you turn their switches off.
# CRM_BRAND_NAME=Open CRM
# LOG_LEVEL=info
