# ==============================================================================
# Host VPS Nginx Reverse Proxy Example (/etc/nginx/sites-available/bn-orbit.conf)
# ==============================================================================
# Use this when your VPS already runs Nginx on ports 80/443 and Docker exposes
# Bn Orbit strictly on loopback 127.0.0.1:7008 (EDGE_MODE=proxy).
#
# After copying & replacing crm.example.com / console.example.com:
#   sudo ln -s /etc/nginx/sites-available/bn-orbit.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d crm.example.com -d console.example.com
# ==============================================================================

server {
    listen 80;
    server_name crm.example.com console.example.com;

    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:7008;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 90s;
    }
}
