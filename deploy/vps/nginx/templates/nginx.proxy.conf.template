# ==============================================================================
# Bn Orbit - Edge Nginx Reverse-Proxy Mode (Behind Host VPS HTTPS Proxy)
# ==============================================================================
# Listens on container port 80 (mapped to host 127.0.0.1:${EDGE_PORT:-7008})
# so the host VPS Nginx/Caddy/Proxy handles Let's Encrypt TLS on 80/443 and
# forwards both CRM_DOMAIN and CONSOLE_DOMAIN traffic here cleanly.
# ==============================================================================

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    server_tokens off;

    # Trust Docker/loopback proxy hops so logs & edge limits track real client IPs
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json;

    client_max_body_size 50M;

    limit_req_zone $binary_remote_addr zone=edge_api:10m rate=40r/s;
    limit_req_zone $binary_remote_addr zone=edge_auth:10m rate=12r/m;
    limit_conn_zone $binary_remote_addr zone=edge_conn:10m;
    limit_req_status 429;
    limit_conn_status 429;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      "";
    }

    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ''      $scheme;
    }

    map $http_x_forwarded_host $forwarded_host {
        default $http_x_forwarded_host;
        ''      $host;
    }

    map $http_x_forwarded_for $forwarded_for {
        default $http_x_forwarded_for;
        ''      $remote_addr;
    }

    upstream crm_web {
        server web:8080;
    }

    upstream crm_console {
        server console:8080;
    }

    upstream crm_api {
        server api:5066;
        keepalive 32;
    }

    # -------------------------------------------------------------------------
    # Main CRM Workspace App (${CRM_DOMAIN})
    # -------------------------------------------------------------------------
    server {
        listen 80 default_server;
        server_name ${CRM_DOMAIN} _;

        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), geolocation=()" always;

        location = /nginx-health {
            allow 127.0.0.1;
            deny all;
            return 200 "ok\n";
        }

        location ~ /\.(?!well-known) {
            deny all;
            access_log off;
            log_not_found off;
        }

        location ~ ^/api/v1/auth/(login|forgot-password|reset-password)$ {
            limit_req zone=edge_auth burst=8 nodelay;
            proxy_pass http://crm_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $forwarded_host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $forwarded_for;
        }

        location ~ ^/api/v1/(telephony/webhooks|wa/webhooks|operator/webhooks)/ {
            proxy_pass http://crm_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $forwarded_host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $forwarded_for;
            proxy_read_timeout 30s;
        }

        location /api/ {
            limit_req zone=edge_api burst=80 nodelay;
            limit_conn edge_conn 40;
            proxy_pass http://crm_api;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $forwarded_host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $forwarded_for;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 90s;
        }

        location /local-files/ {
            limit_req zone=edge_api burst=40 nodelay;
            proxy_pass http://crm_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $forwarded_host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $forwarded_for;
            proxy_buffering off;
            proxy_read_timeout 60s;
        }

        location / {
            proxy_pass http://crm_web;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $forwarded_host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $forwarded_for;
        }
    }

    # -------------------------------------------------------------------------
    # Operator Console App (${CONSOLE_DOMAIN})
    # -------------------------------------------------------------------------
    server {
        listen 80;
        server_name ${CONSOLE_DOMAIN};

        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), geolocation=()" always;

        location ~ /\.(?!well-known) {
            deny all;
            access_log off;
            log_not_found off;
        }

        location ~ ^/api/v1/operator/auth/(login|forgot-password|reset-password)$ {
            limit_req zone=edge_auth burst=6 nodelay;
            proxy_pass http://crm_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $forwarded_host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $forwarded_for;
        }

        location /api/ {
            limit_req zone=edge_api burst=60 nodelay;
            limit_conn edge_conn 30;
            proxy_pass http://crm_api;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $forwarded_host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $forwarded_for;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        location /local-files/ {
            limit_req zone=edge_api burst=40 nodelay;
            proxy_pass http://crm_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $forwarded_host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $forwarded_for;
            proxy_buffering off;
            proxy_read_timeout 60s;
        }

        location / {
            proxy_pass http://crm_console;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $forwarded_host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $forwarded_for;
        }
    }
}
