# ==============================================================================
# Bn Orbit - VPS Edge Nginx Configuration (TLS + Edge Security)
# ==============================================================================
# Rendered automatically at container startup via render-and-run.sh with
# ${CRM_DOMAIN} and ${CONSOLE_DOMAIN}.
# ==============================================================================

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    server_tokens off;

    # Performance
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json;

    # File Upload Limits (50 MB max; smaller per-route limits enforced in API)
    client_max_body_size 50M;

    # Edge DDoS / Brute-force rate limits (provider webhooks bypass these below)
    limit_req_zone $binary_remote_addr zone=edge_api:10m rate=40r/s;
    limit_req_zone $binary_remote_addr zone=edge_auth:10m rate=12r/m;
    limit_conn_zone $binary_remote_addr zone=edge_conn:10m;
    limit_req_status 429;
    limit_conn_status 429;

    # Shared TLS hardening
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Upstream Services (Docker Internal Network)
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      "";
    }

    upstream crm_web {
        server web:8080;
    }

    upstream crm_console {
        server console:8080;
    }

    upstream crm_api {
        server api:5066;
        keepalive 32;
    }

    # -------------------------------------------------------------------------
    # HTTP -> HTTPS Redirect & ACME Certbot Challenge
    # -------------------------------------------------------------------------
    server {
        listen 80;
        server_name ${CRM_DOMAIN} ${CONSOLE_DOMAIN} _;

        location = /nginx-health {
            allow 127.0.0.1;
            deny all;
            return 200 "ok\n";
        }

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # -------------------------------------------------------------------------
    # Main CRM Workspace App (${CRM_DOMAIN})
    # -------------------------------------------------------------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name ${CRM_DOMAIN};

        ssl_certificate     /etc/letsencrypt/live/${CRM_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${CRM_DOMAIN}/privkey.pem;

        # Security Headers (microphone left allowed for WebRTC softphone)
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), geolocation=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        # Block hidden dotfiles (except .well-known)
        location ~ /\.(?!well-known) {
            deny all;
            access_log off;
            log_not_found off;
        }

        # Strict edge rate-limiting on authentication / password reset routes
        location ~ ^/api/v1/auth/(login|forgot-password|reset-password)$ {
            limit_req zone=edge_auth burst=8 nodelay;
            proxy_pass http://crm_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Telephony / WhatsApp / Billing webhooks (never edge-throttled)
        location ~ ^/api/v1/(telephony/webhooks|wa/webhooks|operator/webhooks)/ {
            proxy_pass http://crm_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 30s;
        }

        # Backend REST API Routing
        location /api/ {
            limit_req zone=edge_api burst=80 nodelay;
            limit_conn edge_conn 40;
            proxy_pass http://crm_api;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            proxy_read_timeout 90s;
        }

        # Signed local-disk audio & file downloads
        location /local-files/ {
            limit_req zone=edge_api burst=40 nodelay;
            proxy_pass http://crm_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_read_timeout 60s;
        }

        # Frontend React Web Application
        location / {
            proxy_pass http://crm_web;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # -------------------------------------------------------------------------
    # Operator Console App (${CONSOLE_DOMAIN})
    # -------------------------------------------------------------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name ${CONSOLE_DOMAIN};

        ssl_certificate     /etc/letsencrypt/live/${CONSOLE_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${CONSOLE_DOMAIN}/privkey.pem;

        # Security Headers
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), geolocation=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        location ~ /\.(?!well-known) {
            deny all;
            access_log off;
            log_not_found off;
        }

        # Strict edge rate-limiting on operator auth endpoints
        location ~ ^/api/v1/operator/auth/(login|forgot-password|reset-password)$ {
            limit_req zone=edge_auth burst=6 nodelay;
            proxy_pass http://crm_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Backend Operator API Routing
        location /api/ {
            limit_req zone=edge_api burst=60 nodelay;
            limit_conn edge_conn 30;
            proxy_pass http://crm_api;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        # Signed local-disk audio & file downloads
        location /local-files/ {
            limit_req zone=edge_api burst=40 nodelay;
            proxy_pass http://crm_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_read_timeout 60s;
        }

        # Frontend React Operator Console
        location / {
            proxy_pass http://crm_console;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
