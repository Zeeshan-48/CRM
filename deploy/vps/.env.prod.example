# ==============================================================================
# Bn Orbit - VPS Production Environment Template (.env.prod)
# ==============================================================================
# Copy to deploy/vps/.env.prod on your VPS server and chmod 600 deploy/vps/.env.prod.
# Generate strong random secrets with: openssl rand -hex 32
# ==============================================================================

# ---- Production Runtime & Reverse Proxy ----
NODE_ENV=production
PORT=5066
TRUST_PROXY=1
BRAND_NAME=Bn Orbit

# Host VPS proxy forwards HTTPS traffic on 80/443 -> 127.0.0.1:7008
EDGE_MODE=proxy
EDGE_BIND_IP=127.0.0.1
EDGE_PORT=7008

# ---- Domains, TLS & Public URLs (Replace with your real domain) ----
# Same domain by default: CRM at https://crm.example.com/ and Console at https://crm.example.com/console/
CRM_DOMAIN=crm.example.com
CONSOLE_DOMAIN=crm.example.com
CONSOLE_BASE_PATH=/console/
CERTBOT_EMAIL=admin@example.com

CRM_APP_URL=https://crm.example.com
OPERATOR_APP_URL=https://crm.example.com/console
APP_PUBLIC_URL=https://crm.example.com
CORS_ORIGINS=https://crm.example.com

# ---- Cryptographic Secrets (Generate 64+ random hex chars each) ----
JWT_SECRET=replace-with-64-character-random-hex-string
JWT_EXPIRY=12h
CREDENTIALS_ENCRYPTION_KEY=replace-with-64-character-random-hex-string

# ---- PostgreSQL Database (Internal Docker network) ----
PG_DATABASE_HOST=postgres
PG_DATABASE_PORT=5432
PG_DATABASE_USER=crm
PG_DATABASE_PASSWORD=replace-with-strong-db-password
PG_DATABASE=crm
PG_POOL_MAX=10
PG_POOL_MIN=2

# ---- Redis Password (Internal Docker network, required for BullMQ + rate limits) ----
REDIS_PASSWORD=replace-with-strong-redis-password

# ---- Local File Storage (VPS Disk volume, backed up by backup.sh) ----
LOCAL_STORAGE_DIR=/app/.local-storage

# ---- Google SMTP / Transactional Email Delivery ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=replace-with-google-app-password
SMTP_FROM_EMAIL=notifications@example.com
SMTP_FROM_NAME=Bn Orbit

# ---- Plivo Telephony (LIVE Cloud Voice & WebRTC In-Browser Calling) ----
# Set PLIVO_SIMULATE=false and fill in your real Plivo credentials below.
PLIVO_SIMULATE=false
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_DEFAULT_FROM_NUMBER=
PLIVO_APPLICATION_ID=

# ---- Other Channels (Keep true until configured with live keys) ----
WHATSAPP_SIMULATE=true
TELEPHONY_SIMULATE=true
EXOTEL_SIMULATE=true
RAZORPAY_SIMULATE=true
STRIPE_SIMULATE=true
BILLING_SIMULATE=true
