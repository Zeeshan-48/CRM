# ==============================================================================
# Bn Orbit - VPS Production Environment Template (.env.prod)
# ==============================================================================
# Copy to deploy/vps/.env.prod on your VPS server.
# Fill in your domain names and database credentials.
# ==============================================================================

# ---- Production Runtime ----
NODE_ENV=production
PORT=5066
TRUST_PROXY=1
BRAND_NAME=Bn Orbit

# ---- Domains & Public URLs (Replace with your real domains) ----
CRM_APP_URL=https://crm.example.com
OPERATOR_APP_URL=https://console.example.com
APP_PUBLIC_URL=https://crm.example.com
CORS_ORIGINS=https://crm.example.com,https://console.example.com

# ---- Cryptographic Secrets (Generate 64+ random characters each) ----
JWT_SECRET=replace-with-64-character-random-hex-string
JWT_EXPIRY=12h
CREDENTIALS_ENCRYPTION_KEY=replace-with-64-character-random-hex-string

# ---- PostgreSQL Database (Internal Docker network) ----
PG_DATABASE_HOST=postgres
PG_DATABASE_PORT=5432
PG_DATABASE_USER=crm
PG_DATABASE_PASSWORD=replace-with-strong-db-password
PG_DATABASE=crm
PG_POOL_MAX=10
PG_POOL_MIN=2

# ---- Redis (Internal Docker network) ----
REDIS_URL=redis://redis:6379/0

# ---- Local File Storage (VPS Disk volume) ----
LOCAL_STORAGE_DIR=/app/.local-storage

# ---- Google SMTP / Transactional Email Delivery ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=bnintelhub.services@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM_EMAIL=bnintelhub.services@gmail.com
SMTP_FROM_NAME=Bn Orbit

# ---- Channel Simulation Defaults (Set false when live API keys are provided) ----
WHATSAPP_SIMULATE=true
TELEPHONY_SIMULATE=true
EXOTEL_SIMULATE=true
RAZORPAY_SIMULATE=true
STRIPE_SIMULATE=true
BILLING_SIMULATE=true

